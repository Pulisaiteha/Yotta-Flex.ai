    "/analytics/rejections/reasons": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Data-quality issues grouped by reason",
        "description": "Calls `queries.rejection_reasons()` -> GROUP BY reason over rejected_records.",
        "operationId": "rejection_reasons_analytics_rejections_reasons_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RejectionReason"
                  },
                  "title": "Response Rejection Reasons Analytics Rejections Reasons Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
