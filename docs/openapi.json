  "components": {
    "schemas": {
      "Body_upload_run_pipeline_runs_upload_post": {
        "properties": {
          "customers_file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Customers File",
            "description": "customers.csv"
          },
          "orders_file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Orders File",
            "description": "orders.json"
          }
        },
        "type": "object",
        "required": [
          "customers_file",
          "orders_file"
        ],
        "title": "Body_upload_run_pipeline_runs_upload_post"
      },
      "CityRevenue": {
        "properties": {
          "city": {
            "type": "string",
            "title": "City"
          },
          "revenue_inr": {
            "type": "number",
