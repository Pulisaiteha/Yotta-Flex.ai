                  "type": "array",
                  "title": "Response Revenue By City Analytics Revenue By City Get"
                }
              }
            }
          }
        }
      }
    },
    "/analytics/revenue/by-day": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Revenue By Day",
        "description": "Calls `queries.revenue_by_day()` -> fact_order JOIN dim_date.",
        "operationId": "revenue_by_day_analytics_revenue_by_day_get",
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
