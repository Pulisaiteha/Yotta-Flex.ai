{
  "openapi": "3.1.0",
  "info": {
    "title": "YottaFlex Data Pipeline API",
    "description": "Ingest customers (CSV) and orders (JSON), validate, load a SQLite star schema, and expose monitoring and analytics. Demo page: [/](/) \u00b7 Guide: INTERVIEWER_GUIDE.md",
    "version": "1.0.0"
  },
  "paths": {
    "/demo/reset": {
      "post": {
        "tags": [
          "Source data"
        ],
        "summary": "Step 0: empty the input files AND the warehouse",
        "description": "Demo only. Calls `source_files.clear()` and `database.clear_all_tables()`.",
        "operationId": "reset_demo_demo_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/source/load-sample": {
      "post": {
        "tags": [
          "Source data"
        ],
        "summary": "Step 0: copy the bundled sample (3 customers, 11 orders) into the input files",
        "description": "Calls `source_files.load_sample()`: copies data/input/* to data/workspace/.",
        "operationId": "load_sample_source_load_sample_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/source/customers": {
      "get": {
        "tags": [
          "Source data"
        ],
        "summary": "Step 1: show the rows currently in customers.csv",
        "description": "Calls `source_files.read_customers_file()`.",
        "operationId": "get_source_customers_source_customers_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceFile"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Source data"
        ],
        "summary": "Step 1: add/replace one customer row in customers.csv",
        "description": "Calls `source_files.save_customer()`. No validation here on purpose - the pipeline validates.",
        "operationId": "add_source_customer_source_customers_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceCustomer"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/source/orders": {
      "get": {
        "tags": [
          "Source data"
        ],
        "summary": "Step 2: show the objects currently in orders.json",
        "description": "Calls `source_files.read_orders_file()`.",
        "operationId": "get_source_orders_source_orders_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceFile"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Source data"
        ],
        "summary": "Step 2: append one order to orders.json",
        "description": "Calls `source_files.save_order()`. Blank fields are stored as null so the pipeline can reject them.",
        "operationId": "add_source_order_source_orders_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceOrder"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pipeline/runs": {
      "post": {
        "tags": [
          "Pipeline"
        ],
        "summary": "Step 3: run the pipeline on files already on the server",
        "description": "Calls `execute_run()` -> `runner.run_pipeline()`:\nread files -> validate -> transform -> load in ONE transaction -> record run metrics.",
        "operationId": "create_run_pipeline_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/RunRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Pipeline"
        ],
        "summary": "Step 4: list recent runs (newest first)",
        "description": "Calls `queries.list_runs()` -> SELECT FROM pipeline_runs.",
        "operationId": "list_runs_pipeline_runs_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                "SUCCESS"
              ],
              "title": "Status"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Run"
                  },
                  "title": "Response List Runs Pipeline Runs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pipeline/runs/upload": {
      "post": {
        "tags": [
          "Pipeline"
        ],
        "summary": "Step 3 (alternative): upload customers CSV + orders JSON and run",
        "description": "Calls `save_upload()` twice, then the same `runner.run_pipeline()`.",
        "operationId": "upload_run_pipeline_runs_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_run_pipeline_runs_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pipeline/runs/{run_id}": {
      "get": {
        "tags": [
          "Pipeline"
        ],
        "summary": "Step 4: one run's status, counts and failure message",
        "description": "Calls `queries.get_run()`.",
        "operationId": "get_run_pipeline_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pipeline/runs/{run_id}/rejections": {
      "get": {
        "tags": [
          "Pipeline"
        ],
        "summary": "Step 4: quarantined records of a run, traceable to source row",
        "description": "Calls `queries.get_run()` (404 check) then `queries.list_rejections()`.",
        "operationId": "get_rejections_pipeline_runs__run_id__rejections_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "entity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "customer",
                    "order"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Entity"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Rejection"
                  },
                  "title": "Response Get Rejections Pipeline Runs  Run Id  Rejections Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pipeline/runs/{run_id}/reconciliation": {
      "get": {
        "tags": [
          "Pipeline"
        ],
        "summary": "Step 4: source-to-target count and amount reconciliation",
        "description": "Calls `queries.reconcile_run()`: compares run metrics with real table contents.",
        "operationId": "get_reconciliation_pipeline_runs__run_id__reconciliation_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reconciliation"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/analytics/revenue/summary": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Revenue Summary",
        "description": "Calls `queries.revenue_summary()` -> SUM/COUNT over fact_order.",
        "operationId": "revenue_summary_analytics_revenue_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevenueSummary"
                }
              }
            }
          }
        }
      }
    },
